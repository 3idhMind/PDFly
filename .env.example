# Copy to .env and fill in. `.env` is gitignored — never commit it.
#
# TWO CLASSES OF VARIABLE, and the difference matters:
#
#   VITE_*  -> compiled into the browser bundle. PUBLIC BY DESIGN. Anyone can read
#              these in devtools. Firebase web config belongs here; access is
#              controlled by firestore.rules, not by hiding these values.
#
#   others  -> server-only, read by the Vercel Functions in api/. REAL SECRETS.
#              Set them in the Vercel dashboard. Never prefix one with VITE_ —
#              that would ship it to every visitor.

# ---------------------------------------------------------------- client (public)
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Used for canonical URLs, SEO and internal links.
VITE_SITE_URL=http://localhost:8080

# ------------------------------------------------------------- server (SECRET)
# Firebase service account (Project settings -> Service accounts -> Generate key).
# Keep the literal \n escapes in the private key; do not paste real newlines.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Optional API limits. Defaults live in api/_lib/quota.ts.
PDFLY_RATE_LIMIT_PER_MIN=60
PDFLY_FREE_TIER_MONTHLY_QUOTA=1000

# ------------------------------------------------------------- admin (SECRET)
# Whichever email is listed here gets the admin surface: feedback inbox, blog
# management, and the ability to mint a blog:write API key.
#
# Deliberately NOT VITE_-prefixed. A VITE_ var ships to every visitor's browser,
# which would publish the owner's address and name exactly which account to
# attack. The client asks /api/me for a boolean and never learns the value.
# Compared against the Firebase-verified email inside the ID token, so it cannot
# be spoofed by a client. Comma-separate for more than one operator.
ADMIN_EMAIL=you@example.com

# ------------------------------------------------- object storage (NOT YET ON)
# Until these are set, the API returns generated files inline as base64 and
# stores nothing. That works, but the file only exists in the HTTP response:
# download it or it is gone. Vercel also caps a response body at ~4.5 MB, so a
# batch over roughly 3 MB fails at the platform rather than with one of our
# error codes.
#
# Fill these in and the API switches to returning a short-lived signed URL
# instead. Any S3-compatible bucket works — Cloudflare R2, Backblaze B2, AWS S3.
# R2 is the cheapest fit here because it charges nothing for egress.
#
# Leave them blank to keep today's inline behaviour. The code checks for
# STORAGE_BUCKET and falls back on its own; it never half-enables.
STORAGE_PROVIDER=r2
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# R2: https://<account-id>.r2.cloudflarestorage.com   S3: https://s3.<region>.amazonaws.com
STORAGE_ENDPOINT=
STORAGE_REGION=auto
# How long a download link stays valid, in seconds. 3600 = one hour.
STORAGE_URL_TTL_SECONDS=3600
