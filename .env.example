# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Site URL (used for canonical URLs, SEO, and internal links)
VITE_SITE_URL=https://your-domain.com

# Admin email is configured ONLY as a backend secret (ADMIN_EMAIL).
# It is never exposed to the frontend. The `bootstrap-admin` edge function
# verifies the signed-in user's email against this secret server-side.
