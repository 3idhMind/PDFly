# Copy to .env and fill in. `.env` is gitignored — never commit it.
#
# TWO CLASSES OF VARIABLE, and the difference matters:
#
#   VITE_*  -> compiled into the browser bundle. PUBLIC BY DESIGN. Anyone can read
#              these in devtools. Firebase web config belongs here; access is
#              controlled by firestore.rules, not by hiding these values.
#
#   others  -> server-only, read by the Vercel Functions in api/. REAL SECRETS.
#              Set them in the Vercel dashboard. Never prefix one with VITE_ —
#              that would ship it to every visitor.

# ---------------------------------------------------------------- client (public)
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Used for canonical URLs, SEO and internal links.
VITE_SITE_URL=http://localhost:8080

# ------------------------------------------------------------- server (SECRET)
# Firebase service account (Project settings -> Service accounts -> Generate key).
# Keep the literal \n escapes in the private key; do not paste real newlines.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Optional API limits. Defaults live in api/_lib/quota.ts.
PDFLY_RATE_LIMIT_PER_MIN=60
PDFLY_FREE_TIER_MONTHLY_QUOTA=1000
