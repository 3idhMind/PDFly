# Copy to .env and fill in. `.env` is gitignored — never commit it.
#
# TWO CLASSES OF VARIABLE, and the difference matters:
#
#   VITE_*  -> compiled into the browser bundle. PUBLIC BY DESIGN. Anyone can read
#              these in devtools. Firebase web config belongs here; access is
#              controlled by firestore.rules, not by hiding these values.
#
#   others  -> server-only, read by the Vercel Functions in api/. REAL SECRETS.
#              Set them in the Vercel dashboard. Never prefix one with VITE_ —
#              that would ship it to every visitor.

# ---------------------------------------------------------------- client (public)
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Used for canonical URLs, SEO and internal links.
VITE_SITE_URL=http://localhost:8080

# ------------------------------------------------------------- server (SECRET)
# Firebase service account (Project settings -> Service accounts -> Generate key).
# Keep the literal \n escapes in the private key; do not paste real newlines.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Optional API limits. Defaults live in api/_lib/quota.ts.
PDFLY_RATE_LIMIT_PER_MIN=60
PDFLY_FREE_TIER_MONTHLY_QUOTA=1000

# ------------------------------------------------------------- admin (SECRET)
# Whichever email is listed here gets the admin surface: feedback inbox, blog
# management, and the ability to mint a blog:write API key.
#
# Deliberately NOT VITE_-prefixed. A VITE_ var ships to every visitor's browser,
# which would publish the owner's address and name exactly which account to
# attack. The client asks /api/me for a boolean and never learns the value.
# Compared against the Firebase-verified email inside the ID token, so it cannot
# be spoofed by a client. Comma-separate for more than one operator.
ADMIN_EMAIL=you@example.com

# ----------------------------------------------------------- object storage
# Leave these blank and the API still works: files come back inline in the
# response and nothing is retained. Fill them in and every generated file is
# ALSO uploaded, and the response gains a download link. The file is returned
# inline either way, so a storage outage costs a link, never the document.
#
# FILEN.IO — the provider in use. Chosen because its free tier (10 GB) needs
# only an email address. Backblaze B2, Cloudflare R2 and AWS S3 all demand a
# payment card before issuing credentials, which is why the S3 adapter exists
# and stays unused.
#
#   1. Sign up at https://filen.io (free, no card).
#   2. Use a DEDICATED account for this, never a personal one: the SDK logs in
#      with the account password, so these credentials grant the whole account
#      rather than one scoped bucket.
#   3. Do NOT enable two-factor on that account. A rotating code cannot be put
#      in an environment variable; FILEN_2FA_CODE exists only for a static
#      recovery-style code and is normally left blank.
#
# Files are written under /pdfly-api inside the account.
FILEN_EMAIL=
FILEN_PASSWORD=
FILEN_2FA_CODE=

# The domain download links are built on. Links are always served from OUR
# domain via /api/file/<token>; the storage provider never appears in a URL a
# user sees. Set this to the production origin.
PUBLIC_BASE_URL=https://pdfly.3idhmind.in

# Signs the download tokens. Any long random string. If unset, the Firebase
# private key is used, which is already secret and already present — so a
# missing value can never silently produce forgeable links.
FILE_TOKEN_SECRET=

# How long a download link stays valid, in seconds. 3600 = one hour.
STORAGE_URL_TTL_SECONDS=3600

# --- S3-compatible alternative (Backblaze B2 / Cloudflare R2 / AWS S3) -------
# Only used when FILEN_EMAIL is blank. All four must be set together.
# B2 endpoint: https://s3.<region>.backblazeb2.com
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com  (region: auto)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
