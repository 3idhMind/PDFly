{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:fn*",
      "destination": "https://nlnqpcfezbssssrwddyl.supabase.co/functions/v1/:fn*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
